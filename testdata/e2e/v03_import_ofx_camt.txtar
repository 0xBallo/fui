# v0.3: OFX and CAMT.053 built-in connectors import, deduplicate, and undo; `fui undo` reverts
# the last transaction write.
exec fui init --preset full --currency EUR
exec fui connector list --json
stdout '"name":"ofx"'
stdout '"name":"camt"'

# OFX: preview, apply, re-import is a duplicate, import undo removes the batch.
exec fui import bank.ofx --connector ofx --create-accounts --dry-run --json
stdout '"counts":\{"new":2,'
exec fui import bank.ofx --connector ofx --create-accounts --yes --json
stdout '"batch_id":1,"transactions":2'
exec fui tx list --json
stdout '"description":"Coffee bar'
exec fui import bank.ofx --connector ofx --dry-run --json
stdout '"counts":\{"new":0,"duplicate":2,'
exec fui import undo 1 --yes --json
stdout '"removed_transactions":2'
exec fui tx list --json
stdout '"items":\[\]'

# CAMT.053: two statements, one account each.
exec fui import stmt.xml --connector camt --create-accounts --yes --json
stdout '"batch_id":1,"transactions":2,"accounts":1'
exec fui import stmt.xml --connector camt --dry-run --json
stdout '"counts":\{"new":0,"duplicate":2,'
exec fui import undo 1 --yes --json
stdout '"removed_transactions":2'

# fui undo reverts the last transaction write.
exec fui account add Cash --kind cash --currency EUR
exec fui add -5 Coffee -a Cash
exec fui undo --dry-run
exec fui undo --yes --json
stdout '"kind":"tx.add"'
exec fui tx list -a Cash --json
stdout '"items":\[\]'

-- bank.ofx --
