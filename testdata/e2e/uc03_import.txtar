# UC-03 (docs/specs/funzionali.md "Casi d'uso"): import a bank statement, detect a duplicate
# re-import, undo a batch, then move transactions to another archive via the fui/1 .jsonl
# export/import round trip.
mkdir -p $XDG_CONFIG_HOME/fui
cp profile.toml $XDG_CONFIG_HOME/fui/config.toml
exec fui init --currency EUR
exec fui account add Checking --kind checking --currency EUR

# A CSV profile import: preview, then apply.
exec fui import statement.csv --connector csv --profile mybank --account Checking --dry-run --json
stdout '"counts":\{"new":2,"duplicate":0,"doubtful":0,"errors":0,"included":2\}'
exec fui import statement.csv --connector csv --profile mybank --account Checking --yes --json
stdout '"batch_id":1,"transactions":2'
exec fui tx list --json
stdout '"description":"Rent".*"amount":-3000'
stdout '"description":"Salary".*"amount":150000'

# Re-importing the same file is recognized as a duplicate of batch 1 and plans nothing new.
exec fui import statement.csv --connector csv --profile mybank --account Checking --dry-run --json
stdout '"already_imported_batch_id":1,"counts":\{"new":0,"duplicate":2,"doubtful":0,"errors":0,"included":0\}'
exec fui import list --json
stdout '"id":1,"connector":"csv","source":"statement.csv"'

# Undo removes every transaction the batch created.
exec fui import undo 1 --yes --json
stdout '"removed_transactions":2'
exec fui tx list --json
stdout '^\{"items":\[\],"summary":\{"count":0,"totals":\[\]\},"next":null\}$'

exec fui import statement.csv --connector csv --profile mybank --account Checking --yes --json
stdout '"batch_id":1,"transactions":2'

# Export the archive as fui/1 .jsonl. Duplicate detection is by transaction content, not file
# hash, so importing the export back into the very same archive is still seen as a duplicate.
exec fui export --format fui --output export.fui.jsonl --json
exec fui import export.fui.jsonl --dry-run --json
stdout '"counts":\{"new":0,"duplicate":2,"doubtful":0,"errors":0,"included":0\}'

# Into a second, unrelated archive the same transactions are genuinely new; --create-accounts
# opens Checking there too, from the ref the export carries.

env XDG_DATA_HOME=$WORK/xdg/data-b
env XDG_STATE_HOME=$WORK/xdg/state-b
exec fui init --currency EUR
exec fui import export.fui.jsonl --create-accounts --yes --json
stdout '"batch_id":1,"transactions":2,"accounts":1'
exec fui account show Checking --json
stdout '"balance":147000'

-- profile.toml --
[import.profiles.mybank]
date_column = "Date"
description_column = "Description"
amount_column = "Amount"
date_format = "02/01/2006"
decimal_separator = ","
-- statement.csv --
Date,Description,Amount
05/01/2026,Rent,-30,00
10/01/2026,Salary,1500,00
