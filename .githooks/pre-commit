#!/bin/sh
# Blocks a commit that is unformatted, does not build, or fails vet, lint or tests (see "Flusso Git" in
# docs/specs/tecniche.md). Enable once per clone with `make hooks`; bypass in an emergency with --no-verify.
set -e
make -s fmt-check
go build ./...
go vet ./...
make -s lint
go test -count=1 ./...
