{"path":"fui","short":"Local-first personal finance CLI and TUI","example":"  fui init --currency EUR\n  fui add -12,50 Esselunga -c Groceries -a Checking\n  fui account list --json","flags":[{"name":"csv","default":"false","usage":"output as RFC 4180 CSV"},{"name":"db","usage":"path to the archive (default: XDG data dir)"},{"name":"dry-run","default":"false","usage":"show the plan of a write without applying it"},{"name":"json","default":"false","usage":"output as JSON (snake_case, amounts in minor units)"},{"name":"no-input","default":"false","usage":"never prompt; fail with missing_field instead"},{"name":"verbose","shorthand":"v","default":"false","usage":"verbose logging, including connector stderr"},{"name":"yes","default":"false","usage":"confirm a bulk write or an agent-mode write"}],"commands":[{"path":"fui account","short":"Add, list, show, edit or archive accounts","commands":[{"path":"fui account add","short":"Add an account","example":"  fui account add Checking --kind checking --currency EUR --opening-balance 1000","output_schema":"account","flags":[{"name":"currency","usage":"ISO 4217 currency (required)"},{"name":"description","usage":"description"},{"name":"kind","usage":"cash, checking, credit_card, savings, investment or loan"},{"name":"opened-on","usage":"date the account was opened (default: today)"},{"name":"opening-balance","usage":"balance on opened-on (default: 0)"}]},{"path":"fui account archive","short":"Archive an account","example":"  fui account archive \"Old Savings\"","output_schema":"account"},{"path":"fui account edit","short":"Edit an account","example":"  fui account edit Checking --name \"Main Checking\"","output_schema":"account","flags":[{"name":"description","usage":"new description"},{"name":"kind","usage":"new kind"},{"name":"name","usage":"new name"},{"name":"opening-balance","usage":"new opening balance"}]},{"path":"fui account list","short":"List accounts","example":"  fui account list --include-archived","output_schema":"account[]","flags":[{"name":"at","usage":"balance date (default: today)"},{"name":"include-archived","default":"false","usage":"include archived accounts"}]},{"path":"fui account show","short":"Show one account","example":"  fui account show Checking --at 2026-01-01","output_schema":"account","flags":[{"name":"at","usage":"balance date (default: today)"}]}]},{"path":"fui add","short":"Add a transaction","example":"  fui add -12,50 Esselunga -c Groceries -a Checking\n  fui add -- -12,50 Cash withdrawal -a Checking","output_schema":"transaction","flags":[{"name":"account","shorthand":"a","usage":"account the transaction is on (required)"},{"name":"category","shorthand":"c","usage":"category"},{"name":"date","usage":"accounting date (default: today)"},{"name":"kind","usage":"payment (default), fee, refund, ..."},{"name":"notes","usage":"free-form notes"},{"name":"status","usage":"pending, booked (default) or reconciled"}]},{"path":"fui backup","short":"Write a backup of the archive","example":"  fui backup","output_schema":"backup_result"},{"path":"fui category","short":"Add, list, rename, merge or remove categories","commands":[{"path":"fui category add","short":"Add a category","example":"  fui category add Freelance --kind income","output_schema":"category","flags":[{"name":"kind","usage":"income or expense (default: expense)"}]},{"path":"fui category list","short":"List categories","example":"  fui category list --json","output_schema":"category[]"},{"path":"fui category merge","short":"Merge a category into another","example":"  fui category merge Dinning Dining --yes","output_schema":"merge_result"},{"path":"fui category rename","short":"Rename a category","example":"  fui category rename Dinning Dining","output_schema":"category"},{"path":"fui category rm","short":"Remove a category","example":"  fui category rm \"Other Expenses\" --reassign-to Shopping","output_schema":"merge_result","flags":[{"name":"reassign-to","usage":"category to move existing transactions to"}]}]},{"path":"fui completion","short":"Generate a shell completion script","example":"  fui completion bash > /etc/bash_completion.d/fui\n  fui completion zsh > \"${fpath[1]}/_fui\"","commands":[{"path":"fui completion bash","short":"Generate a bash completion script","example":"  fui completion bash > /etc/bash_completion.d/fui"},{"path":"fui completion fish","short":"Generate a fish completion script","example":"  fui completion fish > ~/.config/fish/completions/fui.fish"},{"path":"fui completion zsh","short":"Generate a zsh completion script","example":"  fui completion zsh > \"${fpath[1]}/_fui\""}]},{"path":"fui config","short":"Read or change the configuration","commands":[{"path":"fui config get","short":"Read a configuration value","example":"  fui config get currency","output_schema":"config_value"},{"path":"fui config set","short":"Change a configuration value","example":"  fui config set currency EUR"}]},{"path":"fui fx","short":"Set or list manual exchange rates","commands":[{"path":"fui fx list","short":"List manual exchange rates","example":"  fui fx list --currency USD","output_schema":"fx_rate[]","flags":[{"name":"currency","usage":"filter by currency (default: every currency)"}]},{"path":"fui fx set","short":"Set a manual exchange rate","example":"  fui fx set USD 1.0842 --date 2026-01-01","output_schema":"fx_rate","flags":[{"name":"date","usage":"date the rate applies from (default: today)"}]}]},{"path":"fui init","short":"Create the default categories","example":"  fui init --currency EUR","output_schema":"init_result","flags":[{"name":"currency","usage":"set the base currency (ISO 4217), e.g. EUR"}]},{"path":"fui restore","short":"Restore the archive from a backup","example":"  fui restore ~/.local/state/fui/backups/fui-2026-01-01.db --yes","output_schema":"restore_result"},{"path":"fui transfer","short":"Transfer money between two accounts","example":"  fui transfer --from Checking --to Savings --amount 200","output_schema":"transaction[]","flags":[{"name":"amount","usage":"amount leaving the source account (required)"},{"name":"date","usage":"accounting date (default: today)"},{"name":"description","usage":"description (default: a generated one)"},{"name":"dest-amount","usage":"amount arriving, when the accounts differ in currency"},{"name":"fee","usage":"fee charged on the source account"},{"name":"from","usage":"source account (required)"},{"name":"status","usage":"pending, booked (default) or reconciled"},{"name":"to","usage":"destination account (required)"}]},{"path":"fui tx","short":"List, show, edit or remove transactions","commands":[{"path":"fui tx edit","short":"Edit a transaction","example":"  fui tx edit 42 --amount -15,00 --confirm-reconciled","output_schema":"transaction","flags":[{"name":"amount","usage":"new amount (not on a transfer leg)"},{"name":"category","usage":"new category (empty clears it)"},{"name":"confirm-reconciled","default":"false","usage":"allow editing a reconciled transaction"},{"name":"date","usage":"new accounting date"},{"name":"description","usage":"new description"},{"name":"kind","usage":"new kind"},{"name":"notes","usage":"new notes"},{"name":"status","usage":"new status"}]},{"path":"fui tx list","short":"List transactions","example":"  fui tx list --account Checking --from 2026-01-01 --json","output_schema":"transaction[]","flags":[{"name":"account","default":"[]","usage":"filter by account (repeatable)"},{"name":"after-date","usage":"resume after this ISO date (from the previous page)"},{"name":"after-id","default":"0","usage":"resume after this transaction id (from the previous page)"},{"name":"category","default":"[]","usage":"filter by category (repeatable)"},{"name":"from","usage":"earliest date, inclusive"},{"name":"limit","default":"0","usage":"page size (default: 100)"},{"name":"max","usage":"maximum amount, inclusive"},{"name":"min","usage":"minimum amount, inclusive"},{"name":"status","default":"[]","usage":"pending, booked or reconciled (repeatable)"},{"name":"text","usage":"case-insensitive substring of description or notes"},{"name":"to","usage":"latest date, inclusive"}]},{"path":"fui tx rm","short":"Remove a transaction","example":"  fui tx rm 42","output_schema":"transaction","flags":[{"name":"confirm-reconciled","default":"false","usage":"allow removing a reconciled transaction"}]},{"path":"fui tx show","short":"Show one transaction","example":"  fui tx show 42","output_schema":"transaction"}]}]}
