index|idx_assets_loan|assets|CREATE INDEX idx_assets_loan ON assets (loan_id) WHERE loan_id IS NOT NULL
index|idx_budget_moves_date|budget_moves|CREATE INDEX idx_budget_moves_date ON budget_moves (date, id)
index|idx_budget_targets_budget|budget_targets|CREATE INDEX idx_budget_targets_budget ON budget_targets (budget_id, id)
index|idx_budget_targets_category|budget_targets|CREATE UNIQUE INDEX idx_budget_targets_category ON budget_targets (category_id) WHERE category_id IS NOT NULL
index|idx_import_batches_sha_imported_at|import_batches|CREATE INDEX idx_import_batches_sha_imported_at
    ON import_batches (source_sha256, imported_at DESC, id DESC)
index|idx_loan_events_loan_event_date|loan_events|CREATE INDEX idx_loan_events_loan_event_date
    ON loan_events (loan_id, event_date, id)
index|idx_loan_installments_schedule_due|loan_installments|CREATE INDEX idx_loan_installments_schedule_due
    ON loan_installments (schedule_id, due_date, id)
index|idx_loan_installments_transaction|loan_installments|CREATE INDEX idx_loan_installments_transaction
    ON loan_installments (transaction_id)
index|idx_loan_schedules_loan_valid_from|loan_schedules|CREATE INDEX idx_loan_schedules_loan_valid_from
    ON loan_schedules (loan_id, valid_from)
index|idx_loans_liability_account|loans|CREATE UNIQUE INDEX idx_loans_liability_account
    ON loans (liability_account_id) WHERE liability_account_id IS NOT NULL
index|idx_loans_name|loans|CREATE UNIQUE INDEX idx_loans_name ON loans (name COLLATE NOCASE)
index|idx_reconciliations_account_closed_date|reconciliations|CREATE INDEX idx_reconciliations_account_closed_date
    ON reconciliations (account_id, closed_at, date DESC, id DESC)
index|idx_recurrences_account_next_date|recurrences|CREATE INDEX idx_recurrences_account_next_date ON recurrences (account_id, next_date, id)
index|idx_recurrences_next_date_id|recurrences|CREATE INDEX idx_recurrences_next_date_id ON recurrences (next_date, id)
index|idx_rules_enabled_priority_name|rules|CREATE INDEX idx_rules_enabled_priority_name
    ON rules (enabled, priority, name)
index|idx_securities_isin|securities|CREATE UNIQUE INDEX idx_securities_isin
    ON securities (isin COLLATE NOCASE) WHERE isin IS NOT NULL
index|idx_securities_ticker|securities|CREATE UNIQUE INDEX idx_securities_ticker
    ON securities (ticker COLLATE NOCASE) WHERE ticker IS NOT NULL
index|idx_security_ops_account_date_id|security_ops|CREATE INDEX idx_security_ops_account_date_id
    ON security_ops (account_id, date, id)
index|idx_security_ops_cash_tx|security_ops|CREATE INDEX idx_security_ops_cash_tx
    ON security_ops (cash_tx_id) WHERE cash_tx_id IS NOT NULL
index|idx_security_ops_security_date_id|security_ops|CREATE INDEX idx_security_ops_security_date_id
    ON security_ops (security_id, date, id)
index|idx_security_prices_security_date|security_prices|CREATE INDEX idx_security_prices_security_date
    ON security_prices (security_id, date)
index|idx_transaction_splits_category|transaction_splits|CREATE INDEX idx_transaction_splits_category ON transaction_splits (category_id)
index|idx_transaction_splits_transaction|transaction_splits|CREATE INDEX idx_transaction_splits_transaction ON transaction_splits (transaction_id, id)
index|idx_transaction_tags_tag|transaction_tags|CREATE INDEX idx_transaction_tags_tag ON transaction_tags (tag_id)
index|idx_transactions_account_date_id|transactions|CREATE INDEX idx_transactions_account_date_id
    ON transactions (account_id, date, id)
index|idx_transactions_category_date|transactions|CREATE INDEX idx_transactions_category_date
    ON transactions (category_id, date)
index|idx_transactions_date_id|transactions|CREATE INDEX idx_transactions_date_id
    ON transactions (date, id)
index|idx_transactions_fingerprint|transactions|CREATE INDEX idx_transactions_fingerprint
    ON transactions (fingerprint)
index|idx_transactions_payee|transactions|CREATE INDEX idx_transactions_payee
    ON transactions (payee_id)
index|idx_transactions_recurrence_status_due_date|transactions|CREATE INDEX idx_transactions_recurrence_status_due_date
    ON transactions (recurrence_id, status, due_date, id)
table|accounts|accounts|CREATE TABLE accounts (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    description TEXT NOT NULL DEFAULT '',
    kind TEXT NOT NULL CHECK (kind IN ('cash', 'checking', 'credit_card', 'savings', 'investment', 'loan')),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    opening_balance_minor INTEGER NOT NULL,
    opened_on TEXT NOT NULL CHECK (length(opened_on) = 10),
    archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1)),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
, iban TEXT CHECK (iban IS NULL OR length(iban) BETWEEN 15 AND 34)) STRICT
table|asset_valuations|asset_valuations|CREATE TABLE asset_valuations (
    id INTEGER PRIMARY KEY,
    asset_id INTEGER NOT NULL REFERENCES assets (id) ON DELETE CASCADE,
    date TEXT NOT NULL CHECK (length(date) = 10),
    value_minor INTEGER NOT NULL CHECK (value_minor >= 0),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (asset_id, date)
) STRICT
table|assets|assets|CREATE TABLE assets (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    kind TEXT NOT NULL CHECK (kind IN ('property', 'vehicle', 'other')),
    purchase_date TEXT NOT NULL CHECK (length(purchase_date) = 10),
    purchase_minor INTEGER NOT NULL CHECK (purchase_minor >= 0),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    loan_id INTEGER REFERENCES loans (id) ON DELETE SET NULL,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|budget_amounts|budget_amounts|CREATE TABLE budget_amounts (
    id INTEGER PRIMARY KEY,
    budget_id INTEGER NOT NULL REFERENCES budgets (id) ON DELETE CASCADE,
    year INTEGER NOT NULL,
    month INTEGER NOT NULL CHECK (month BETWEEN 1 AND 12),
    amount_minor INTEGER NOT NULL CHECK (amount_minor >= 0),
    UNIQUE (budget_id, year, month)
) STRICT
table|budget_moves|budget_moves|CREATE TABLE budget_moves (
    id INTEGER PRIMARY KEY,
    date TEXT NOT NULL CHECK (length(date) = 10),
    from_budget_id INTEGER REFERENCES budgets (id) ON DELETE CASCADE,
    to_budget_id INTEGER REFERENCES budgets (id) ON DELETE CASCADE,
    amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    CHECK (from_budget_id IS NOT to_budget_id),
    CHECK (from_budget_id IS NOT NULL OR to_budget_id IS NOT NULL)
) STRICT
table|budget_targets|budget_targets|CREATE TABLE budget_targets (
    id INTEGER PRIMARY KEY,
    budget_id INTEGER NOT NULL REFERENCES budgets (id) ON DELETE CASCADE,
    category_id INTEGER REFERENCES categories (id) ON DELETE RESTRICT,
    tag_id INTEGER REFERENCES tags (id) ON DELETE RESTRICT,
    CHECK ((category_id IS NULL) <> (tag_id IS NULL))
) STRICT
table|budgets|budgets|CREATE TABLE budgets (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    mode TEXT NOT NULL CHECK (mode IN ('cap', 'envelope')),
    amount_minor INTEGER NOT NULL CHECK (amount_minor >= 0),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    carry INTEGER NOT NULL DEFAULT 0 CHECK (carry IN (0, 1)),
    threshold_warn INTEGER NOT NULL DEFAULT 80 CHECK (threshold_warn >= 1),
    threshold_over INTEGER NOT NULL DEFAULT 100 CHECK (threshold_over >= threshold_warn),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|categories|categories|CREATE TABLE categories (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    kind TEXT NOT NULL CHECK (kind IN ('income', 'expense')),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|connector_account_refs|connector_account_refs|CREATE TABLE connector_account_refs (
    id INTEGER PRIMARY KEY,
    connector TEXT NOT NULL,
    ref TEXT NOT NULL,
    account_id INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (connector, ref)
) STRICT
table|dismissed_insights|dismissed_insights|CREATE TABLE dismissed_insights (
    key TEXT PRIMARY KEY,
    kind TEXT NOT NULL CHECK (kind IN ('anomaly', 'subscription', 'price_change', 'trend')),
    dismissed_at TEXT NOT NULL CHECK (length(dismissed_at) >= 20)
) STRICT
table|fx_rates|fx_rates|CREATE TABLE fx_rates (
    id INTEGER PRIMARY KEY,
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    date TEXT NOT NULL CHECK (length(date) = 10),
    rate_scaled INTEGER NOT NULL CHECK (rate_scaled > 0),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (currency, date)
) STRICT
table|goose_db_version|goose_db_version|CREATE TABLE goose_db_version (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		version_id INTEGER NOT NULL,
		is_applied INTEGER NOT NULL,
		tstamp TIMESTAMP DEFAULT (datetime('now'))
	)
table|import_batches|import_batches|CREATE TABLE import_batches (
    id INTEGER PRIMARY KEY,
    connector TEXT NOT NULL,
    source TEXT NOT NULL,
    source_sha256 TEXT NOT NULL,
    imported_at TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|loan_events|loan_events|CREATE TABLE loan_events (
    id INTEGER PRIMARY KEY,
    loan_id INTEGER NOT NULL REFERENCES loans (id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('rate_change', 'renegotiation', 'prepayment')),
    event_date TEXT NOT NULL CHECK (length(event_date) = 10),
    new_rate_basis_points INTEGER CHECK (new_rate_basis_points IS NULL OR new_rate_basis_points > 0),
    new_term_months INTEGER CHECK (new_term_months IS NULL OR new_term_months >= 1),
    prepaid_minor INTEGER CHECK (prepaid_minor IS NULL OR prepaid_minor > 0),
    prepaid_currency TEXT CHECK (prepaid_currency IS NULL OR length(prepaid_currency) = 3),
    prepay_mode TEXT CHECK (prepay_mode IS NULL OR prepay_mode IN ('reduce_installment', 'reduce_term')),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|loan_installments|loan_installments|CREATE TABLE loan_installments (
    id INTEGER PRIMARY KEY,
    schedule_id INTEGER NOT NULL REFERENCES loan_schedules (id) ON DELETE CASCADE,
    due_date TEXT NOT NULL CHECK (length(due_date) = 10),
    principal_minor INTEGER NOT NULL CHECK (principal_minor >= 0),
    interest_minor INTEGER NOT NULL CHECK (interest_minor >= 0),
    fees_minor INTEGER NOT NULL CHECK (fees_minor >= 0),
    remaining_minor INTEGER NOT NULL CHECK (remaining_minor >= 0),
    transaction_id INTEGER REFERENCES transactions (id) ON DELETE SET NULL,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (schedule_id, due_date)
) STRICT
table|loan_schedules|loan_schedules|CREATE TABLE loan_schedules (
    id INTEGER PRIMARY KEY,
    loan_id INTEGER NOT NULL REFERENCES loans (id) ON DELETE CASCADE,
    valid_from TEXT NOT NULL CHECK (length(valid_from) = 10),
    origin TEXT NOT NULL CHECK (origin IN ('imported', 'computed')),
    rate_basis_points INTEGER NOT NULL CHECK (rate_basis_points > 0),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (loan_id, valid_from)
) STRICT
table|loans|loans|CREATE TABLE loans (
    id INTEGER PRIMARY KEY,
    kind TEXT NOT NULL CHECK (kind IN ('mortgage', 'loan')),
    principal_minor INTEGER NOT NULL CHECK (principal_minor > 0),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    disbursed_on TEXT NOT NULL CHECK (length(disbursed_on) = 10),
    term_months INTEGER NOT NULL CHECK (term_months >= 1),
    rate_type TEXT NOT NULL CHECK (rate_type IN ('fixed', 'variable', 'mixed')),
    debit_account_id INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
, name TEXT NOT NULL DEFAULT '', liability_account_id INTEGER REFERENCES accounts (id) ON DELETE RESTRICT) STRICT
table|op_log|op_log|CREATE TABLE op_log (
    id INTEGER PRIMARY KEY,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL CHECK (json_valid(payload)),
    created_at TEXT NOT NULL,
    undone_at TEXT
) STRICT
table|payee_aliases|payee_aliases|CREATE TABLE payee_aliases (
    id INTEGER PRIMARY KEY,
    payee_id INTEGER NOT NULL REFERENCES payees (id) ON DELETE CASCADE,
    alias TEXT NOT NULL UNIQUE COLLATE NOCASE
) STRICT
table|payees|payees|CREATE TABLE payees (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|reconciliations|reconciliations|CREATE TABLE reconciliations (
    id INTEGER PRIMARY KEY,
    account_id INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT,
    date TEXT NOT NULL CHECK (length(date) = 10),
    statement_balance_minor INTEGER NOT NULL,
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    closed_at TEXT CHECK (closed_at IS NULL OR length(closed_at) >= 20),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (account_id, date)
) STRICT
table|recurrences|recurrences|CREATE TABLE "recurrences" (
    id INTEGER PRIMARY KEY,
    account_id INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT,
    category_id INTEGER REFERENCES categories (id) ON DELETE RESTRICT,
    description TEXT NOT NULL DEFAULT '',
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    every INTEGER NOT NULL CHECK (every > 0),
    unit TEXT NOT NULL CHECK (unit IN ('days', 'weeks', 'months')),
    day_of_month INTEGER NOT NULL DEFAULT 0 CHECK (day_of_month >= 0 AND day_of_month <= 31),
    start_date TEXT NOT NULL CHECK (length(start_date) = 10),
    end_date TEXT CHECK (end_date IS NULL OR length(end_date) = 10),
    next_date TEXT CHECK (next_date IS NULL OR length(next_date) = 10),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|rules|rules|CREATE TABLE rules (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    priority INTEGER NOT NULL,
    enabled INTEGER NOT NULL CHECK (enabled IN (0, 1)),
    conditions TEXT NOT NULL CHECK (json_valid(conditions)),
    actions TEXT NOT NULL CHECK (json_valid(actions)),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|saved_reports|saved_reports|CREATE TABLE saved_reports (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    kind TEXT NOT NULL,
    params TEXT NOT NULL CHECK (json_valid(params)),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|saved_simulations|saved_simulations|CREATE TABLE saved_simulations (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    kind TEXT NOT NULL CHECK (kind IN ('investment', 'pac', 'cashflow')),
    params TEXT NOT NULL CHECK (json_valid(params)),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|securities|securities|CREATE TABLE securities (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    ticker TEXT,
    isin TEXT,
    kind TEXT NOT NULL CHECK (kind IN ('stock', 'etf', 'bond', 'fund', 'crypto')),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    quantity_scale INTEGER NOT NULL CHECK (quantity_scale >= 0 AND quantity_scale <= 8),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    CHECK (
        (ticker IS NOT NULL AND trim(ticker) <> '')
        OR (isin IS NOT NULL AND trim(isin) <> '')
    ),
    CHECK (ticker IS NULL OR trim(ticker) = ticker),
    CHECK (isin IS NULL OR trim(isin) = isin)
) STRICT
table|security_ops|security_ops|CREATE TABLE security_ops (
    id INTEGER PRIMARY KEY,
    date TEXT NOT NULL CHECK (length(date) = 10),
    account_id INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT,
    security_id INTEGER NOT NULL REFERENCES securities (id) ON DELETE RESTRICT,
    kind TEXT NOT NULL CHECK (kind IN ('buy', 'sell', 'dividend', 'coupon')),
    quantity_units INTEGER NOT NULL CHECK (quantity_units > 0),
    quantity_scale INTEGER NOT NULL CHECK (quantity_scale >= 0 AND quantity_scale <= 8),
    unit_price_minor INTEGER NOT NULL CHECK (unit_price_minor >= 0),
    unit_price_currency TEXT NOT NULL CHECK (length(unit_price_currency) = 3),
    fees_minor INTEGER NOT NULL DEFAULT 0 CHECK (fees_minor >= 0),
    fees_currency TEXT NOT NULL CHECK (length(fees_currency) = 3),
    cash_tx_id INTEGER REFERENCES transactions (id) ON DELETE SET NULL,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    CHECK (fees_currency = unit_price_currency)
) STRICT
table|security_prices|security_prices|CREATE TABLE security_prices (
    id INTEGER PRIMARY KEY,
    security_id INTEGER NOT NULL REFERENCES securities (id) ON DELETE RESTRICT,
    date TEXT NOT NULL CHECK (length(date) = 10),
    price_minor INTEGER NOT NULL CHECK (price_minor > 0),
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    UNIQUE (security_id, date)
) STRICT
table|tags|tags|CREATE TABLE tags (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
) STRICT
table|transaction_splits|transaction_splits|CREATE TABLE transaction_splits (
    id INTEGER PRIMARY KEY,
    transaction_id INTEGER NOT NULL REFERENCES transactions (id) ON DELETE CASCADE,
    category_id INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT,
    amount_minor INTEGER NOT NULL CHECK (amount_minor <> 0),
    note TEXT NOT NULL DEFAULT ''
) STRICT
table|transaction_tags|transaction_tags|CREATE TABLE transaction_tags (
    transaction_id INTEGER NOT NULL REFERENCES transactions (id) ON DELETE CASCADE,
    tag_id INTEGER NOT NULL REFERENCES tags (id) ON DELETE CASCADE,
    PRIMARY KEY (transaction_id, tag_id)
) STRICT, WITHOUT ROWID
table|transactions|transactions|CREATE TABLE transactions (
    id INTEGER PRIMARY KEY,
    account_id INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT,
    date TEXT NOT NULL CHECK (length(date) = 10),
    operation_date TEXT CHECK (operation_date IS NULL OR length(operation_date) = 10),
    value_date TEXT CHECK (value_date IS NULL OR length(value_date) = 10),
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL CHECK (length(currency) = 3),
    payee_id INTEGER REFERENCES payees (id) ON DELETE RESTRICT,
    description TEXT NOT NULL DEFAULT '',
    category_id INTEGER REFERENCES categories (id) ON DELETE RESTRICT,
    notes TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL CHECK (status IN ('pending', 'booked', 'reconciled')),
    kind TEXT NOT NULL CHECK (kind IN ('payment', 'transfer', 'exchange', 'fee', 'interest', 'refund', 'investment', 'other')),
    external_id TEXT,
    fingerprint TEXT NOT NULL DEFAULT '',
    import_batch_id INTEGER REFERENCES import_batches (id) ON DELETE SET NULL,
    transfer_group_id INTEGER,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    search_text TEXT NOT NULL DEFAULT '', recurrence_id INTEGER REFERENCES recurrences (id) ON DELETE SET NULL, due_date TEXT CHECK (due_date IS NULL OR length(due_date) = 10),
    UNIQUE (account_id, external_id)
) STRICT
table|transactions_fts|transactions_fts|CREATE VIRTUAL TABLE transactions_fts USING fts5 (
    search_text,
    content = 'transactions',
    content_rowid = 'id',
    tokenize = 'trigram'
)
table|transactions_fts_config|transactions_fts_config|CREATE TABLE 'transactions_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID
table|transactions_fts_data|transactions_fts_data|CREATE TABLE 'transactions_fts_data'(id INTEGER PRIMARY KEY, block BLOB)
table|transactions_fts_docsize|transactions_fts_docsize|CREATE TABLE 'transactions_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB)
table|transactions_fts_idx|transactions_fts_idx|CREATE TABLE 'transactions_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID
table|transfer_groups|transfer_groups|CREATE TABLE transfer_groups (
    id INTEGER PRIMARY KEY,
    fee_minor INTEGER NOT NULL DEFAULT 0,
    fee_currency TEXT CHECK (fee_currency IS NULL OR length(fee_currency) = 3),
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    CHECK ((fee_minor = 0 AND fee_currency IS NULL) OR (fee_currency IS NOT NULL))
) STRICT
trigger|transactions_fts_ad|transactions|CREATE TRIGGER transactions_fts_ad AFTER DELETE ON transactions BEGIN
    INSERT INTO transactions_fts (transactions_fts, rowid, search_text) VALUES ('delete', old.id, old.search_text);
END
trigger|transactions_fts_ai|transactions|CREATE TRIGGER transactions_fts_ai AFTER INSERT ON transactions BEGIN
    INSERT INTO transactions_fts (rowid, search_text) VALUES (new.id, new.search_text);
END
trigger|transactions_fts_au|transactions|CREATE TRIGGER transactions_fts_au AFTER UPDATE OF search_text ON transactions BEGIN
    INSERT INTO transactions_fts (transactions_fts, rowid, search_text) VALUES ('delete', old.id, old.search_text);
    INSERT INTO transactions_fts (rowid, search_text) VALUES (new.id, new.search_text);
END
